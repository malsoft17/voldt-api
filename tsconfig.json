{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "paths": {
      "@fastify/multipart": ["./node_modules/@fastify/multipart/types/index.d.ts"],
      "@fastify/static": ["./node_modules/@fastify/static/types/index.d.ts"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
  },
  "include": ["src"]
}
